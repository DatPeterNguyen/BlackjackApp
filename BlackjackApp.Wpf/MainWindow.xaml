<Window x:Class="BlackjackApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlackjackApp.Wpf"
        mc:Ignorable="d"
        Title="Blackjack" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B3D2E">

    <!--
        HOUR 0-1 LAYOUT SKELETON (still in place)
        HOUR 1-6.5: hardcoded card/chip images to judge layout, before real
        dealing logic existed.
        DAY 2: Dealer area and Hand 1 slot are now wired to the real engine
        (Deck/Hand/StandardBlackjackVariant) - they show actual dealt cards
        and update live as you Hit/Stand/Double. Hands 2-5 are still static
        placeholders; they get wired up once multi-hand support is built.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#14261F" CornerRadius="6" Padding="12,8" HorizontalAlignment="Left">
                <TextBlock x:Name="BalanceText" Text="Balance: $1,000" Foreground="White" FontSize="18" FontWeight="Bold"/>
            </Border>

            <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings" Padding="12,8" Click="SettingsButton_OnClick"/>
        </Grid>

        <!-- Row 1: Dealer area - live cards from the real Deck/Hand -->
        <Border Grid.Row="1" BorderBrush="#3A6B57" BorderThickness="2" CornerRadius="8"
                Background="#0E4433" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Dealer" Foreground="#8FBFA9" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel x:Name="DealerCardsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DealerValueText" Text="" Foreground="#8FBFA9" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!--
            Row 2: Player hand slots.
            Slot 1 (Hand 1) is now the live, real hand. Slots 2-5 stay as
            static placeholder art until multi-hand support is built.
        -->
        <Border Grid.Row="2" BorderBrush="#3A6B57" BorderThickness="2" CornerRadius="8"
                Background="#0E4433" Margin="0,0,0,12">
            <UniformGrid x:Name="PlayerHandsPanel" Rows="1" Columns="5">
                <Border Margin="6" BorderBrush="#8FBFA9" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel x:Name="PlayerHandCardsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                        <Image x:Name="PlayerHandChipImage" Height="44" Margin="0,8,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock x:Name="PlayerHandBetText" Text="Bet: $0" Foreground="#8FBFA9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PlayerHandValueText" Text="" Foreground="#8FBFA9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="6" BorderBrush="#8FBFA9" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Hand 2" Foreground="#8FBFA9" HorizontalAlignment="Center"/>
                        <TextBlock Text="(coming with multi-hand support)" Foreground="#4F7A65" FontSize="10"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="120" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="6" BorderBrush="#8FBFA9" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Hand 3" Foreground="#8FBFA9" HorizontalAlignment="Center"/>
                        <TextBlock Text="(coming with multi-hand support)" Foreground="#4F7A65" FontSize="10"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="120" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="6" BorderBrush="#8FBFA9" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Hand 4" Foreground="#8FBFA9" HorizontalAlignment="Center"/>
                        <TextBlock Text="(coming with multi-hand support)" Foreground="#4F7A65" FontSize="10"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="120" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="6" BorderBrush="#8FBFA9" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Hand 5" Foreground="#8FBFA9" HorizontalAlignment="Center"/>
                        <TextBlock Text="(coming with multi-hand support)" Foreground="#4F7A65" FontSize="10"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="120" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Row 3: Bet display + round result -->
        <Border Grid.Row="3" Background="#14261F" CornerRadius="6" Padding="12,8"
                HorizontalAlignment="Center" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock x:Name="CurrentBetText" Text="Current Bet: $0" Foreground="White" FontSize="20"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ResultText" Text="" Foreground="#FFD700" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 4: Chip buttons -->
        <StackPanel x:Name="ChipButtonsPanel" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button Content="$1" Width="60" Height="60" Margin="4" Click="ChipButton_OnClick" Tag="1"/>
            <Button Content="$5" Width="60" Height="60" Margin="4" Click="ChipButton_OnClick" Tag="5"/>
            <Button Content="$10" Width="60" Height="60" Margin="4" Click="ChipButton_OnClick" Tag="10"/>
            <Button Content="$25" Width="60" Height="60" Margin="4" Click="ChipButton_OnClick" Tag="25"/>
            <Button Content="$100" Width="60" Height="60" Margin="4" Click="ChipButton_OnClick" Tag="100"/>
            <Button Content="$1000" Width="60" Height="60" Margin="4" Click="ChipButton_OnClick" Tag="1000"/>
            <Button Content="$10K" Width="60" Height="60" Margin="4" Click="ChipButton_OnClick" Tag="10000"/>
            <Button x:Name="ClearBetButton" Content="Clear" Width="60" Height="60" Margin="16,4,4,4" Click="ClearBetButton_OnClick"/>
        </StackPanel>

        <!-- Row 5: Action buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="DealButton" Content="Deal" Width="100" Height="44" Margin="4" FontWeight="Bold" Click="DealButton_OnClick"/>
            <Button x:Name="HitButton" Content="Hit" Width="100" Height="44" Margin="4" IsEnabled="False" Click="HitButton_OnClick"/>
            <Button x:Name="StandButton" Content="Stand" Width="100" Height="44" Margin="4" IsEnabled="False" Click="StandButton_OnClick"/>
            <Button x:Name="DoubleButton" Content="Double" Width="100" Height="44" Margin="4" IsEnabled="False" Click="DoubleButton_OnClick"/>
            <Button x:Name="SplitButton" Content="Split" Width="100" Height="44" Margin="4" IsEnabled="False" Click="SplitButton_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
