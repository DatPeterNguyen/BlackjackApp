<Window x:Class="BlackjackApp.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#0B3D2E">

    <!--
        HOUR 6.5-7.5 SHELL
        Deck-count selector (1-6, default 4 per the design doc), hand-count
        selector (1-5, default 1), and variant picker (Standard / Double
        Down Madness / War). None of these controls do anything real yet -
        selecting a value doesn't change any game state. This just locks in
        where these controls live before they're wired to
        BlackjackApp.core.Models.Deck, the table's hand slots, and the
        IGameVariant implementations.
    -->
    <StackPanel Margin="24">
        <TextBlock Text="Settings" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Number of Decks" Foreground="#8FBFA9" Margin="0,0,0,6"/>
        <ComboBox x:Name="DeckCountComboBox" Width="120" HorizontalAlignment="Left" SelectedIndex="3">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="6"/>
        </ComboBox>

        <TextBlock Text="Number of Hands" Foreground="#8FBFA9" Margin="0,20,0,6"/>
        <ComboBox x:Name="HandCountComboBox" Width="120" HorizontalAlignment="Left" SelectedIndex="0">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
        </ComboBox>

        <TextBlock Text="Variant" Foreground="#8FBFA9" Margin="0,20,0,6"/>
        <ComboBox x:Name="VariantComboBox" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
            <ComboBoxItem Content="Standard Blackjack"/>
            <ComboBoxItem Content="Black Double Down Madness"/>
            <ComboBoxItem Content="War Blackjack"/>
        </ComboBox>

        <Button x:Name="SaveButton" Content="Save" Width="100" Height="36"
                HorizontalAlignment="Right" Margin="0,32,0,0" Click="SaveButton_OnClick"/>
    </StackPanel>
</Window>
