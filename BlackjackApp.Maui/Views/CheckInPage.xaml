<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlackjackApp.Maui.Views.CheckInPage"
             Title="Daily Reward"
             BackgroundColor="#2A4D00">

    <!--
        The daily check-in reward (item 14 on the polish list). Days 1-6 of a
        streak pay a flat $100; day 7 pays a wheel spin worth $100 - $1,000.
        All the streak arithmetic lives in BlackjackApp.core's DailyCheckIn
        (pure and date-driven, so it's unit tested); this page only draws it
        and persists the claim through GameProgressStorage.

        The seven-day strip and the wheel's wedges are both built in
        code-behind - the strip because its tiles restyle per day state, and
        the wheel because it's drawn with a custom IDrawable (see
        WheelDrawable in CheckInPage.xaml.cs) and spun by animating the
        GraphicsView's Rotation onto the winning wedge.
    -->
    <Grid SafeAreaEdges="None">
        <!--
            SafeAreaEdges="None" on this root so the table art stays
            full-bleed behind the notch and the home indicator. .NET 10
            changed the default: layouts now inset themselves ("Container")
            unless told otherwise, so without this the artwork would stop
            short of the screen edges on a notched iPhone and leave bars.
            The content layer below opts back in, so only the controls
            actually move inwards.
        -->
        <!-- One opaque layer rather than two translucent ones - see MainPage.xaml. -->
        <Image Source="table_green.png" Aspect="AspectFill" InputTransparent="True"/>

        <ScrollView SafeAreaEdges="Container">
            <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
                <Label Text="Daily Reward" Style="{StaticResource FeltHeading}" FontSize="33" HorizontalOptions="Center"/>
                <!-- Time until the next reward unlocks. The check-in runs on a rolling 24-hour clock (see BlackjackApp.core.Services.DailyCheckIn), which is invisible without this - a player who just missed the window would otherwise have no idea whether to come back in a minute or most of a day. Ticked once a second by CheckInPage.TickCountdown while the page is open. -->
                <Label x:Name="CountdownLabel" Text="" Style="{StaticResource FeltHeading}" TextColor="#FFC400"
                       FontSize="20" HorizontalOptions="Center" IsVisible="False" Margin="0,2,0,0"/>

                <Label x:Name="StreakSummaryLabel" Text="" Style="{StaticResource FeltCaption}" FontSize="13"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                <!-- The 7-day cycle at a glance - tiles built by BuildDayStrip. -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="DayStripLayout" Spacing="6" HorizontalOptions="Center"/>
                </ScrollView>

                <!--
                    Day 7 only. The GraphicsView draws the wheel and is what
                    actually rotates; the pointer sits on top of it, fixed, so
                    whichever wedge ends up under the pointer is the prize.
                -->
                <Grid x:Name="WheelContainer" IsVisible="False" HeightRequest="250" WidthRequest="250"
                      HorizontalOptions="Center" Margin="0,4,0,0">
                    <Grid.GestureRecognizers>
                        <!-- Tapping anywhere on the wheel spins it - see WheelContainer_OnTapped. -->
                        <TapGestureRecognizer Tapped="WheelContainer_OnTapped"/>
                    </Grid.GestureRecognizers>
                    <GraphicsView x:Name="WheelView" HeightRequest="240" WidthRequest="240"
                                  HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Polygon Points="0,0 24,0 12,20" Fill="#FFC400" Stroke="#3C1D00" StrokeThickness="1"
                             HorizontalOptions="Center" VerticalOptions="Start"/>
                </Grid>

                <!-- Shown instead of a Claim button on an actionable day-7 - see RefreshForStatus. -->
                <Label x:Name="WheelHintLabel" Text="Tap the wheel to spin!" Style="{StaticResource FeltCaption}" FontSize="13"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="False"/>

                <Label x:Name="OutcomeLabel" Text="" Style="{StaticResource FeltHeading}" TextColor="#FFC400" FontSize="22"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="False"/>

                <Button x:Name="ClaimButton" Text="CLAIM" Style="{StaticResource GreenButton}" HeightRequest="54" FontSize="23"
                        Margin="0,4,0,0" Clicked="ClaimButton_OnClicked"/>
                <!-- Debug builds only (see CheckInPage.xaml.cs) - jumps the saved streak to "day 6, claimed yesterday" so tapping Claim lands on
                     the real day-7 wheel, without waiting a week for it to come around naturally. Stays hidden and inert in Release. -->
                <Button x:Name="DebugForceDayButton" Text="Debug: Force Day 7" Style="{StaticResource GoldButton}" HeightRequest="38" FontSize="15" IsVisible="False" Clicked="DebugForceDayButton_OnClicked"/>
                <Button x:Name="CloseButton" Text="Close" Style="{StaticResource RedButton}" HeightRequest="46" Clicked="CloseButton_OnClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
