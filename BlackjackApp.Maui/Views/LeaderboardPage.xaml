<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlackjackApp.Maui.Views.LeaderboardPage"
             Title="Leaderboard"
             BackgroundColor="#2A4D00">

    <!--
        Local-only leaderboard (start menu only - see GameMenuPage's
        LeaderboardButton): the highest wallet balance ever reached, one row
        per player. Only one row exists today (the local player, "You" -
        see GameProgressStorage.LocalPlayerName), but ranking by balance and
        keeping a player name on every row (see LeaderboardEntry) means this
        same list and this same page are ready for BlackjackApp.core.
        Services.ILeaderboardService (an intentional stub for now) to add
        other players' rows onto later, without reshaping anything here.
        Rows are built in code-behind since the count varies (currently
        always 1, but not forever).
    -->
    <Grid SafeAreaEdges="None">
        <!--
            SafeAreaEdges="None" on this root so the table art stays
            full-bleed behind the notch and the home indicator. .NET 10
            changed the default: layouts now inset themselves ("Container")
            unless told otherwise, so without this the artwork would stop
            short of the screen edges on a notched iPhone and leave bars.
            The content layer below opts back in, so only the controls
            actually move inwards.
        -->
        <!-- One opaque layer rather than two translucent ones - see MainPage.xaml. -->
        <Image Source="table_green.png" Aspect="AspectFill" InputTransparent="True"/>

        <ScrollView SafeAreaEdges="Container">
            <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
                <Label Text="Leaderboard" Style="{StaticResource FeltHeading}" FontSize="33" HorizontalOptions="Center"/>
                <Label Text="Highest balance ever reached" Style="{StaticResource FeltCaption}" FontSize="13" HorizontalOptions="Center" Margin="0,0,0,4"/>

                <!-- Says what the list below currently is: the global board, or a fallback to this device's own records when it can't be reached. Hidden entirely once the global board has loaded, since by then the rows speak for themselves. -->
                <Label x:Name="StatusLabel" Text="" Style="{StaticResource FeltCaption}" FontSize="12"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="False" Margin="0,0,0,4"/>

                <!-- One row per leaderboard entry - see LeaderboardPage.xaml.cs BuildRows. Shown instead of this when there's nothing to rank yet. -->
                <VerticalStackLayout x:Name="RowsLayout" Spacing="8"/>

                <!-- Shown instead of RowsLayout when the leaderboard is empty (a brand new player who hasn't finished a round yet). -->
                <Label x:Name="EmptyLabel" Text="Play a round to set your first record." Style="{StaticResource FeltCaption}" FontSize="14"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="False" Margin="0,12,0,0"/>

                <Button x:Name="CloseButton" Text="Close" Style="{StaticResource RedButton}" HeightRequest="46" Margin="0,10,0,0" Clicked="CloseButton_OnClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
