<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Casino look-and-feel, built to match the CraftPix "Blackjack Game Kit"
    art that now lives in Resources/Images.

    Every colour in here was sampled straight out of the kit's own PNGs
    rather than picked by eye, so the parts we draw in XAML sit in exactly
    the same palette as the parts that are bitmaps:

      felt greens          table_1.png
      rail orange          table_1.png (the wooden lip)
      button gradients     button_hit / _stand / _double / _split .png
      readout white/maroon win_money.png
      badge navy           score_panel_1.png

    Why some controls are art and some are XAML: anything whose text is
    fixed and baked into the artwork (HIT, STAND, DOUBLE, SPLIT,
    SURRENDER) uses the PNG directly via ImageButton. Anything whose label
    is ours (Deal, Clear, All In, Press, Cash Out, Insure...) or whose
    width has to follow the text (balance, bet and result readouts) is
    drawn here instead, because stretching a fixed-aspect PNG to fit a
    longer string would visibly distort the artwork's corners and border.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        The display face. Bebas Neue is the font the kit's own button art is
        lettered in (its readme.txt names it), so text we draw sits in the
        same typeface as the text painted into btn_hit/btn_stand/btn_double/
        btn_split. Registered in MauiProgram.cs under this alias.

        It ships in a single weight, so nothing styled with it asks for
        FontAttributes="Bold" - there is no bold cut to reach, and the
        renderer would synthesise one by smearing the glyphs, which on a
        face this condensed turns the counters to mud. It's already heavy.

        It's also all-caps (lowercase is drawn as small capitals), which is
        why it's scoped to buttons, headings and money/score readouts.
        Sentence-length text - the rules descriptions, hints, captions -
        stays in Open Sans via FeltCaption and the body styles.
    -->
    <x:String x:Key="DisplayFont">BebasNeue</x:String>

    <!-- ===== Palette (sampled from the kit) ===== -->
    <Color x:Key="ReadoutFill">#FFFFFF</Color>
    <Color x:Key="ReadoutBorder">#4D0000</Color>
    <Color x:Key="ReadoutInk">#4D0000</Color>

    <Color x:Key="PanelInk">#112401</Color>
    <Color x:Key="PanelEdge">#BD450E</Color>
    <Color x:Key="CasinoGold">#FFC400</Color>

    <!-- Button gradient endpoints, top and bottom of each kit button -->
    <Color x:Key="GreenTop">#CDEE3C</Color>
    <Color x:Key="GreenBottom">#6DBA13</Color>
    <Color x:Key="GreenInk">#234A00</Color>
    <Color x:Key="RedTop">#EE230F</Color>
    <Color x:Key="RedBottom">#C80602</Color>
    <Color x:Key="GoldTop">#FECA00</Color>
    <Color x:Key="GoldBottom">#D57F00</Color>
    <Color x:Key="GoldInk">#5A3800</Color>
    <Color x:Key="BlueTop">#10A1EB</Color>
    <Color x:Key="BlueBottom">#036EC5</Color>

    <!-- ===== Brushes ===== -->
    <LinearGradientBrush x:Key="GreenButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GreenTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource GreenBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource RedTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource RedBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GoldTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource GoldBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BlueTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource BlueBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ===== Buttons ===== -->
    <!--
        BasedOn is deliberately left off: Styles.xaml ships MAUI's default
        implicit Button style (purple, Primary-coloured), and inheriting
        from it would drag its VisualStateManager along, whose Normal state
        re-applies that BackgroundColor on top of our Background brush.
    -->
    <Style x:Key="CasinoButton" TargetType="Button">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <!-- Bebas is condensed, so it reads a size or two smaller than Open
             Sans at the same point size; these numbers are set against how
             it actually renders, not carried over from the old face. -->
        <Setter Property="FontSize" Value="19" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource RedButtonBrush}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- A small squash on press, the same feedback the kit's
                         own pressed-state button frames imply. -->
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.95" />
                            <Setter Property="Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource CasinoButton}">
        <Setter Property="Background" Value="{StaticResource GreenButtonBrush}" />
        <Setter Property="TextColor" Value="{StaticResource GreenInk}" />
    </Style>

    <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource CasinoButton}">
        <Setter Property="Background" Value="{StaticResource RedButtonBrush}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource CasinoButton}">
        <Setter Property="Background" Value="{StaticResource GoldButtonBrush}" />
        <Setter Property="TextColor" Value="{StaticResource GoldInk}" />
    </Style>

    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource CasinoButton}">
        <Setter Property="Background" Value="{StaticResource BlueButtonBrush}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <!-- Square-ish variant for the chip tray's Clear / All In, which sit
         beside 56px chips and would tower over them at the default height. -->
    <Style x:Key="ChipTrayButton" TargetType="Button" BasedOn="{StaticResource CasinoButton}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="WidthRequest" Value="62" />
        <Setter Property="HeightRequest" Value="62" />
        <Setter Property="MinimumHeightRequest" Value="62" />
        <Setter Property="CornerRadius" Value="31" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ===== Readouts and panels ===== -->
    <!-- The white, maroon-bordered plate the kit uses for BET / PAID /
         BALANCE (win_money.png), rebuilt so it can size to its text. -->
    <Style x:Key="ReadoutPlate" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ReadoutFill}" />
        <Setter Property="Stroke" Value="{StaticResource ReadoutBorder}" />
        <Setter Property="StrokeThickness" Value="5" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <Style x:Key="ReadoutText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ReadoutInk}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <!-- The translucent dark plate the kit lays over felt for the player
         nameplates and the dealer strip (avatar_player_active_1.png). -->
    <Style x:Key="FeltPanel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#59000000" />
        <Setter Property="Stroke" Value="{StaticResource CasinoGold}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <!-- The dark inset rows the kit uses inside its settings/shop windows. -->
    <Style x:Key="InkPanel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PanelInk}" />
        <Setter Property="Stroke" Value="{StaticResource PanelEdge}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <!-- Headings over felt need a dark edge to stay legible against the
         bright centre of the radial gradient. -->
    <Style x:Key="FeltHeading" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#000000" Offset="0,2" Radius="3" Opacity="0.75" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deliberately left in the body face: this carries full sentences
         ("Play a round to set your first record.", "Tap a mode to select
         it, then hit Play to start."), which the display face is the wrong
         tool for. -->
    <Style x:Key="FeltCaption" TargetType="Label">
        <Setter Property="TextColor" Value="#E6F3C8" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!--
        The Shell chrome. Styles.xaml ships MAUI's default, which paints the
        nav bar white in light mode - a bright band sitting directly on top
        of the felt. This dictionary is merged after that one in App.xaml,
        so this implicit style wins, and it deliberately drops the
        AppThemeBinding: the table looks the same in both system themes, so
        a nav bar that follows the OS theme would only ever mismatch it.
    -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource PanelInk}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource CasinoGold}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource CasinoGold}" />
        <Setter Property="Shell.DisabledColor" Value="#6F7D55" />
        <Setter Property="Shell.UnselectedColor" Value="#E6F3C8" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>
</ResourceDictionary>
