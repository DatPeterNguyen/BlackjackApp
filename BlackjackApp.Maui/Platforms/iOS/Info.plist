<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!--
		Both orientations. The table now has a portrait form as well as a
		landscape one, and portrait is the better fit on a phone: it has
		over 800pt of height to spend where landscape has under 400, which
		is what let the type grow to a readable size. See MainPage.xaml.cs
		ApplyAdaptiveMetrics for how the table rearranges itself.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
		Google's sample AdMob app id - the SDK refuses to start without one.
		Replace with the real app id from the AdMob console before release,
		alongside the ad unit in AdMobRewardedAdService.

		NOT yet present, and required before shipping ads that use the IDFA:
		NSUserTrackingUsageDescription plus an App Tracking Transparency
		prompt, and SKAdNetworkItems. Without those the app still serves ads,
		just non-personalised ones, which is the right default until there is
		a real AdMob account behind this.
	-->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
