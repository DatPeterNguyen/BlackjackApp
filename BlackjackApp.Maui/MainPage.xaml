<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlackjackApp.Maui.MainPage"
             Title="Blackjack"
             BackgroundColor="#0B3D2E">

    <!--
        MOBILE PORT of the WPF MainWindow: same game (Deck/Hand/
        StandardBlackjackVariant), same single-live-hand-slot layout, just
        re-expressed in MAUI's controls (Border/Grid/StackLayout/Label
        instead of WPF's Window/Grid/StackPanel/TextBlock) and wrapped in
        ScrollViews so it doesn't overflow on a phone screen. Hands 2-5 are
        still static placeholders, same as the WPF version - multi-hand
        support lands for both platforms at the same time.
    -->
    <ScrollView>
        <Grid Padding="16" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

            <!-- Row 0: Top bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Border Grid.Column="0" BackgroundColor="#14261F" StrokeShape="RoundRectangle 6"
                        Padding="12,8" HorizontalOptions="Start">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="BalanceLabel" Text="Balance: $1,000" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                        <Label x:Name="VariantLabel" Text="Standard Blackjack" TextColor="#8FBFA9" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
                <Button x:Name="SettingsButton" Grid.Column="1" Text="Settings" Padding="12,8" Clicked="SettingsButton_OnClicked"/>
            </Grid>

            <!-- Row 1: Dealer area - live cards from the real Deck/Hand -->
            <Border x:Name="DealerAreaBorder" Grid.Row="1" Stroke="#3A6B57" StrokeThickness="2" StrokeShape="RoundRectangle 8"
                    BackgroundColor="#0E4433" Padding="8">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="Dealer" TextColor="#8FBFA9" FontSize="14" HorizontalOptions="Center"/>
                    <HorizontalStackLayout x:Name="DealerCardsLayout" HorizontalOptions="Center" Spacing="4"/>
                    <Label x:Name="DealerValueLabel" Text="" TextColor="#8FBFA9" FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!--
                Row 2: Player hand slots. Slot 1 is the live, real hand.
                Slots 2-5 stay as static placeholders until multi-hand
                support is built.
            -->
            <Border x:Name="PlayerAreaBorder" Grid.Row="2" Stroke="#3A6B57" StrokeThickness="2" StrokeShape="RoundRectangle 8"
                    BackgroundColor="#0E4433" Padding="8">
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                    <Border Grid.Column="0" Stroke="#8FBFA9" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="4">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <HorizontalStackLayout x:Name="PlayerHandCardsLayout" HorizontalOptions="Center" Spacing="2"/>
                            <Image x:Name="PlayerHandChipImage" HeightRequest="36"/>
                            <Label x:Name="PlayerHandBetLabel" Text="Bet: $0" TextColor="#8FBFA9" HorizontalOptions="Center" FontSize="12"/>
                            <Label x:Name="PlayerHandValueLabel" Text="" TextColor="#8FBFA9" HorizontalOptions="Center" FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Stroke="#8FBFA9" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="4">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="Hand 2" TextColor="#8FBFA9" HorizontalOptions="Center" FontSize="12"/>
                            <Label Text="(coming soon)" TextColor="#4F7A65" FontSize="9" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Stroke="#8FBFA9" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="4">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="Hand 3" TextColor="#8FBFA9" HorizontalOptions="Center" FontSize="12"/>
                            <Label Text="(coming soon)" TextColor="#4F7A65" FontSize="9" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Stroke="#8FBFA9" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="4">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="Hand 4" TextColor="#8FBFA9" HorizontalOptions="Center" FontSize="12"/>
                            <Label Text="(coming soon)" TextColor="#4F7A65" FontSize="9" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="4" Stroke="#8FBFA9" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="4">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="Hand 5" TextColor="#8FBFA9" HorizontalOptions="Center" FontSize="12"/>
                            <Label Text="(coming soon)" TextColor="#4F7A65" FontSize="9" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 3: Bet display + round result -->
            <Border Grid.Row="3" BackgroundColor="#14261F" StrokeShape="RoundRectangle 6" Padding="12,8" HorizontalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label x:Name="CurrentBetLabel" Text="Current Bet: $0" TextColor="White" FontSize="20"
                           FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="ResultLabel" Text="" TextColor="#FFD700" FontSize="16" FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Row 4: Chip buttons - horizontally scrollable so it fits on a phone width -->
            <ScrollView Grid.Row="4" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="ChipButtonsLayout" Spacing="4" HorizontalOptions="Center">
                    <Button Text="$1" WidthRequest="56" HeightRequest="56" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="1"/>
                    <Button Text="$5" WidthRequest="56" HeightRequest="56" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="5"/>
                    <Button Text="$10" WidthRequest="56" HeightRequest="56" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="10"/>
                    <Button Text="$25" WidthRequest="56" HeightRequest="56" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="25"/>
                    <Button Text="$100" WidthRequest="56" HeightRequest="56" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="100"/>
                    <Button Text="$1000" WidthRequest="56" HeightRequest="56" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="1000"/>
                    <Button Text="$10K" WidthRequest="56" HeightRequest="56" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="10000"/>
                    <Button x:Name="ClearBetButton" Text="Clear" WidthRequest="56" HeightRequest="56" Margin="12,2,2,2" Clicked="ClearBetButton_OnClicked"/>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Row 5: Action buttons - also horizontally scrollable -->
            <ScrollView Grid.Row="5" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Button x:Name="DealButton" Text="Deal" WidthRequest="90" HeightRequest="44" Margin="2" FontAttributes="Bold" Clicked="DealButton_OnClicked"/>
                    <Button x:Name="HitButton" Text="Hit" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="HitButton_OnClicked"/>
                    <Button x:Name="StandButton" Text="Stand" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="StandButton_OnClicked"/>
                    <Button x:Name="DoubleButton" Text="Double" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="DoubleButton_OnClicked"/>
                    <Button x:Name="SplitButton" Text="Split" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="SplitButton_OnClicked"/>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>
    </ScrollView>
</ContentPage>
