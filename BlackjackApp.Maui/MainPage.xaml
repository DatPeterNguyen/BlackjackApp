<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlackjackApp.Maui.MainPage"
             Title="Blackjack"
             BackgroundColor="#0B3D2E">

    <!--
        Game table: dealer area, 1-5 player hand slots (built dynamically
        per the chosen hand count - see MainPage.xaml.cs), a shared bet/
        result readout, and the chip/action button rows. Wrapped in
        ScrollViews throughout so nothing overflows on a phone screen.
    -->
    <ScrollView>
        <Grid Padding="16" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <!-- Row 0: Top bar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Border Grid.Column="0" BackgroundColor="#14261F" StrokeShape="RoundRectangle 6"
                        Padding="12,8" HorizontalOptions="Start">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="BalanceLabel" Text="Balance: $1,000" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                        <Label x:Name="VariantLabel" Text="Standard Blackjack" TextColor="#8FBFA9" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
                <Button x:Name="SettingsButton" Grid.Column="1" Text="Settings" Padding="12,8" Clicked="SettingsButton_OnClicked"/>
            </Grid>

            <!--
                Row 1: Dealer area - live cards from the real Deck/Hand -
                flanked by the shoe (left, where the dealing animation's
                cards visually come from) and the discard pile (right,
                where each round's played cards actually go instead of
                vanishing) it deals from and discards into.
            -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Image x:Name="ShoeImage" Source="back_red.png" HeightRequest="70" Aspect="AspectFit"/>
                    <Label Text="Shoe" TextColor="#8FBFA9" FontSize="11" HorizontalOptions="Center"/>
                    <Label x:Name="ShoeCountLabel" Text="—" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="TableLimitsLabel" Text="" TextColor="#8FBFA9" FontSize="10" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border x:Name="DealerAreaBorder" Grid.Column="1" Stroke="#3A6B57" StrokeThickness="2" StrokeShape="RoundRectangle 8"
                        BackgroundColor="#0E4433" Padding="8">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="Dealer" TextColor="#8FBFA9" FontSize="14" HorizontalOptions="Center"/>
                        <FlexLayout x:Name="DealerCardsLayout" Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" HorizontalOptions="Fill"/>
                        <Label x:Name="DealerValueLabel" Text="" TextColor="#8FBFA9" FontSize="14" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Image x:Name="DiscardImage" Source="back_red.png" HeightRequest="70" Aspect="AspectFit" Opacity="0.55"/>
                    <Label Text="Discard" TextColor="#8FBFA9" FontSize="11" HorizontalOptions="Center"/>
                    <Label x:Name="DiscardCountLabel" Text="0" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!--
                Row 2: Player hand slots - one per active hand (1-5, chosen
                in Settings). Each slot's cards/chip/bet/value views are
                built at runtime in code-behind (see MainPage.xaml.cs
                BuildHandSlots) since the count varies; tapping a slot
                before dealing selects it as the current betting target, and
                whichever slot is currently being played gets a highlighted
                border.
            -->
            <Border x:Name="PlayerAreaBorder" Grid.Row="2" Stroke="#3A6B57" StrokeThickness="2" StrokeShape="RoundRectangle 8"
                    BackgroundColor="#0E4433" Padding="8">
                <FlexLayout x:Name="PlayerHandsLayout" Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Center"/>
            </Border>

            <!--
                Row 3: Total wagered across every active hand + general/
                system messages. Each hand's own bet and result live in its
                own slot (Row 2) since bets are sized independently per hand.
            -->
            <Border Grid.Row="3" BackgroundColor="#14261F" StrokeShape="RoundRectangle 6" Padding="12,8" HorizontalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label x:Name="CurrentBetLabel" Text="Total Wagered: $0" TextColor="White" FontSize="20"
                           FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="ResultLabel" Text="" TextColor="#FFD700" FontSize="16" FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label x:Name="WarTotalLabel" Text="" TextColor="#7FB3FF" FontSize="14" FontAttributes="Bold"
                           HorizontalOptions="Center" IsVisible="False"/>
                    <Label x:Name="TotalResultLabel" Text="" TextColor="#FFD700" FontSize="14" FontAttributes="Bold"
                           HorizontalOptions="Center" IsVisible="False"/>
                </VerticalStackLayout>
            </Border>

            <!--
                Row 4: War Blackjack only - toggles whether chip taps size
                the main blackjack bet or the optional War side bet for the
                selected hand. Hidden entirely for the other variants.
            -->
            <Button x:Name="BetTargetButton" Grid.Row="4" Text="Betting: Main Bet" IsVisible="False"
                    HorizontalOptions="Center" Padding="12,6" Clicked="BetTargetButton_OnClicked"/>

            <!-- Row 5: Chip buttons - horizontally scrollable so it fits on a phone width -->
            <ScrollView Grid.Row="5" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="ChipButtonsLayout" Spacing="4" HorizontalOptions="Center">
                    <Button Text="$1" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="1"/>
                    <Button Text="$5" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="5"/>
                    <Button Text="$10" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="10"/>
                    <Button Text="$25" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="25"/>
                    <Button Text="$100" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="100"/>
                    <Button Text="$1K" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="1000"/>
                    <Button Text="$10K" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="2" Clicked="ChipButton_OnClicked" CommandParameter="10000"/>
                    <Button x:Name="ClearBetButton" Text="Clear" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="14" Margin="12,2,2,2" Clicked="ClearBetButton_OnClicked"/>
                    <Button x:Name="AllInButton" Text="All In" WidthRequest="60" HeightRequest="60" Padding="0" FontSize="12" Margin="2" Clicked="AllInButton_OnClicked"/>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Row 6: Action buttons - also horizontally scrollable -->
            <ScrollView Grid.Row="6" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Button x:Name="DealButton" Text="Deal" WidthRequest="90" HeightRequest="44" Margin="2" FontAttributes="Bold" Clicked="DealButton_OnClicked"/>
                    <Button x:Name="HitButton" Text="Hit" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="HitButton_OnClicked"/>
                    <Button x:Name="StandButton" Text="Stand" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="StandButton_OnClicked"/>
                    <Button x:Name="DoubleButton" Text="Double" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="DoubleButton_OnClicked"/>
                    <Button x:Name="SplitButton" Text="Split" WidthRequest="90" HeightRequest="44" Margin="2" IsEnabled="False" Clicked="SplitButton_OnClicked"/>
                    <!-- War Blackjack only - shown after a hand's War card beats the dealer's, replacing the normal action buttons for that moment. -->
                    <Button x:Name="PressWarButton" Text="Press" WidthRequest="90" HeightRequest="44" Margin="2" FontSize="13" IsVisible="False" Clicked="PressWarButton_OnClicked"/>
                    <Button x:Name="CashOutWarButton" Text="Cash Out" WidthRequest="90" HeightRequest="44" Margin="2" FontSize="13" IsVisible="False" Clicked="CashOutWarButton_OnClicked"/>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>
    </ScrollView>
</ContentPage>
